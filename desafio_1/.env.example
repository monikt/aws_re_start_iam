# =====================================================
# CONFIGURACIÓN DE AWS
# =====================================================
# Obtener estas credenciales de:
# https://console.aws.amazon.com -> IAM -> Users -> Your User -> Security Credentials

AWS_ACCESS_KEY_ID=ASIAWIBDWS3ZCDE5ENGV
AWS_SECRET_ACCESS_KEY=HQNJCDpupAYvNG/oev3oDBccpcgmor0YFKblKlRK
AWS_REGION=us-east-1
S3_BUCKET_NAME=aws-restart-desafio-1-backups



# =====================================================
# RUTAS LOCALES
# =====================================================
# Ruta de los archivos a respaldar
LOCAL_FILES_PATH=/workspaces/aws_re_start_iam/desafio_1/files

# =====================================================
# CONFIGURACIÓN DE EMAIL (SMTP)
# =====================================================

# Proveedor: 'smtp' o 'ses' (AWS SES)
EMAIL_PROVIDER=smtp

# Para Gmail:
# 1. Habilita autenticación de 2 factores
# 2. Crea una "App Password" en https://myaccount.google.com/apppasswords
# 3. Usa la app password aquí (NO la contraseña de tu cuenta)

SMTP_HOST=smtp.outlook.com
SMTP_PORT=587
SMTP_USERNAME=monica.cas195@hotmail.com
SMTP_PASSWORD=morethan123
SMTP_USE_TLS=True

# Para otros proveedores:
# - Outlook: smtp.outlook.com (puerto 587)
# - SendGrid: smtp.sendgrid.net (puerto 587)
# - Mailgun: smtp.mailgun.org (puerto 587)

# =====================================================
# DESTINATARIOS DE EMAIL
# =====================================================

# Email del remitente
FROM_EMAIL=monica.cas195@hotmail.com

# Emails de destino (separados por comas)
TO_EMAILS=monica.cas195@hotmail.com

# Habilitar envío de emails
SEND_EMAILS=True

# =====================================================
# CONFIGURACIÓN DE AUTOMATIZACIÓN
# =====================================================

# Hora del day en que se ejecutará el backup (formato 24h: HH:MM)
BACKUP_TIME=02:00

# Timezone (ej: 'UTC', 'America/New_York', 'America/Bogota', 'America/Mexico_City')
TIMEZONE=UTC

# =====================================================
# CONFIGURACIÓN DE SEGURIDAD
# =====================================================

# Retención de backups en días (0 = sin límite)
BACKUP_RETENTION_DAYS=30

# Verificar SSL para SMTP
VERIFY_SSL=True

# Modo debug
DEBUG=False

# =====================================================
# AWS SES (Si usas este proveedor en lugar de SMTP)
# =====================================================

# Región de AWS SES
SES_REGION=us-east-1

# Nota: Necesitarás verificar tus direcciones de email en AWS SES
# y posiblemente obtener salida de sandbox SES
